<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_consultpro_consultant" model="res.groups">
        <field name="name">ConsultPro / Consultant</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_consultpro_manager" model="res.groups">
        <field name="name">ConsultPro / Project Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_consultpro_consultant'))]"/>
    </record>

    <record id="group_consultpro_account_manager" model="res.groups">
        <field name="name">ConsultPro / Account Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_consultpro_manager'))]"/>
    </record>

    <record id="group_consultpro_admin" model="res.groups">
        <field name="name">ConsultPro / Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_consultpro_account_manager'))]"/>
    </record>

    <record id="base.user_root" model="res.users">
        <field name="group_ids" eval="[(4, ref('consultpro_management.group_consultpro_admin'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('consultpro_management.group_consultpro_admin'))]"/>
    </record>

    <record id="rule_timesheet_consultant_own" model="ir.rule">
        <field name="name">Timesheet: Consultant sees own only</field>
        <field name="model_id" ref="model_consultpro_timesheet"/>
        <field name="domain_force">[('consultant_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_consultpro_consultant'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_timesheet_manager_all" model="ir.rule">
        <field name="name">Timesheet: Manager sees all</field>
        <field name="model_id" ref="model_consultpro_timesheet"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_consultpro_manager'))]"/>
    </record>

    <record id="rule_project_consultant_assigned" model="ir.rule">
        <field name="name">Project: Consultant sees assigned only</field>
        <field name="model_id" ref="model_consultpro_project"/>
        <field name="domain_force">[('consultant_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_consultpro_consultant'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_project_manager_all" model="ir.rule">
        <field name="name">Project: Manager sees all</field>
        <field name="model_id" ref="model_consultpro_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_consultpro_manager'))]"/>
    </record>

    <record id="rule_task_consultant_assigned" model="ir.rule">
        <field name="name">Task: Consultant sees assigned only</field>
        <field name="model_id" ref="model_consultpro_task"/>
        <field name="domain_force">[('assigned_to_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_consultpro_consultant'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_task_manager_all" model="ir.rule">
        <field name="name">Task: Manager sees all</field>
        <field name="model_id" ref="model_consultpro_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_consultpro_manager'))]"/>
    </record>

</odoo>