<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_consultpro_client_form" model="ir.ui.view">
        <field name="name">consultpro.client.form</field>
        <field name="model">consultpro.client</field>
        <field name="arch" type="xml">
            <form string="Client">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="consultpro_management.group_consultpro_account_manager"/>
                    <button name="action_hold" string="Put On Hold" type="object"
                            invisible="state != 'active'"
                            groups="consultpro_management.group_consultpro_account_manager"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state not in ('active', 'on_hold')"
                            groups="consultpro_management.group_consultpro_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                groups="consultpro_management.group_consultpro_account_manager">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                        <button name="action_view_projects" type="object"
                                class="oe_stat_button" icon="fa-briefcase">
                            <field name="project_count" widget="statinfo" string="Projects"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Client Name"/></h1>
                        <field name="code" class="text-muted"/>
                    </div>
                    <group>
                        <group string="Client Info">
                            <field name="partner_id"/>
                            <field name="client_type"/>
                            <field name="industry_id"/>
                            <field name="date_onboarded"/>
                        </group>
                        <group string="Commercial">
                            <field name="account_manager_id"/>
                            <field name="currency_id"/>
                            <field name="total_revenue" widget="monetary"/>
                            <field name="primary_contact_id"/>
                        </group>
                    </group>
                    <group string="Contact Details">
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="website" widget="url"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Add internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_consultpro_client_list" model="ir.ui.view">
        <field name="name">consultpro.client.list</field>
        <field name="model">consultpro.client</field>
        <field name="arch" type="xml">
            <list string="Clients"
                  decoration-muted="state == 'closed'"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'on_hold'">
                <field name="code"/>
                <field name="name"/>
                <field name="client_type"/>
                <field name="industry_id"/>
                <field name="account_manager_id"/>
                <field name="contract_count"/>
                <field name="project_count"/>
                <field name="total_revenue" widget="monetary" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'on_hold'"
                       decoration-danger="state == 'closed'"
                       decoration-info="state == 'draft'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_consultpro_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">consultpro.client</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first client!
            </p>
        </field>
    </record>

</odoo>