<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_consultpro_invoice_list" model="ir.ui.view">
        <field name="name">consultpro.invoice.list</field>
        <field name="model">consultpro.invoice</field>
        <field name="arch" type="xml">
            <list string="ConsultPro Invoices"
                  decoration-muted="state == 'cancel'"
                  decoration-success="payment_state == 'paid'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="project_id"/>
                <field name="invoice_date"/>
                <field name="period_from" optional="show"/>
                <field name="period_to" optional="show"/>
                <field name="amount_total" widget="monetary"/>
                <field name="state"/>
                <field name="payment_state"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_open_invoice" type="object"
                        string="Open Invoice" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_consultpro_invoice_search" model="ir.ui.view">
        <field name="name">consultpro.invoice.search</field>
        <field name="model">consultpro.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Invoices">
                <field name="name"/>
                <field name="client_id"/>
                <field name="project_id"/>
                <separator/>
                <filter name="posted" string="Posted"
                        domain="[('state', '=', 'posted')]"/>
                <filter name="unpaid" string="Unpaid"
                        domain="[('payment_state', '=', 'not_paid'), ('state', '=', 'posted')]"/>
                <filter name="paid" string="Paid"
                        domain="[('payment_state', '=', 'paid')]"/>
                <separator/>
                <filter name="group_client" string="Client"
                        context="{'group_by': 'client_id'}"/>
                <filter name="group_project" string="Project"
                        context="{'group_by': 'project_id'}"/>
                <filter name="group_month" string="Month"
                        context="{'group_by': 'invoice_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_consultpro_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">consultpro.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_consultpro_invoice_search"/>
        <field name="context">{'search_default_posted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No invoices found
            </p>
        </field>
    </record>

</odoo>