<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_consultpro_project_form" model="ir.ui.view">
        <field name="name">consultpro.project.form</field>
        <field name="model">consultpro.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <header>
                    <button name="action_start" string="Start Project" type="object"
                            class="btn-primary" invisible="state != 'planning'"
                            groups="consultpro_management.group_consultpro_manager"/>
                    <button name="action_hold" string="Put On Hold" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_review" string="Mark for Review" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"
                            groups="consultpro_management.group_consultpro_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planning,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-credit-card"
                                groups="consultpro_management.group_consultpro_account_manager">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Over Budget" bg_color="text-bg-danger"
                            invisible="not is_over_budget"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Project Name"/></h1>
                        <div><field name="code" readonly="True" class="text-muted"/></div>
                    </div>
                    <group>
                        <group string="Project Info">
                            <field name="client_id"/>
                            <field name="contract_id"
                                   domain="[('client_id', '=', client_id), ('state', 'in', ('active', 'approved'))]"/>
                            <field name="project_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="project_manager_id"/>
                        </group>
                        <group string="Timeline and Budget">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="days_remaining"/>
                            <field name="estimated_hours"/>
                            <field name="budget" widget="monetary"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="KPIs">
                        <group>
                            <field name="logged_hours" readonly="True"/>
                            <field name="remaining_hours" readonly="True"/>
                        </group>
                        <group>
                            <field name="budget_spent" widget="monetary" readonly="True"/>
                            <field name="completion_rate" readonly="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Consultants" name="team">
                            <field name="consultant_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="seniority"/>
                                    <field name="availability"/>
                                    <field name="utilization_rate"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scope and Description" name="description">
                            <group>
                                <field name="scope_of_work" colspan="2"/>
                                <field name="objectives" colspan="2"/>
                                <field name="risks" colspan="2"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_consultpro_project_list" model="ir.ui.view">
        <field name="name">consultpro.project.list</field>
        <field name="model">consultpro.project</field>
        <field name="arch" type="xml">
            <list string="Projects"
                  decoration-danger="is_over_budget or days_remaining &lt; 0"
                  decoration-warning="days_remaining &lt; 7 and days_remaining &gt;= 0"
                  decoration-muted="state in ('done', 'cancelled')">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="project_manager_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_remaining"/>
                <field name="completion_rate" optional="show"/>
                <field name="logged_hours" optional="show"/>
                <field name="budget_spent" widget="monetary" optional="show"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="is_over_budget" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_consultpro_project_search" model="ir.ui.view">
        <field name="name">consultpro.project.search</field>
        <field name="model">consultpro.project</field>
        <field name="arch" type="xml">
            <search string="Search Projects">
                <field name="name"/>
                <field name="client_id"/>
                <field name="project_manager_id"/>
                <separator/>
                <filter name="active_projects" string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter name="over_budget" string="Over Budget"
                        domain="[('is_over_budget', '=', True)]"/>
                <separator/>
                <filter name="group_client" string="Client"
                        context="{'group_by': 'client_id'}"/>
                <filter name="group_type" string="Type"
                        context="{'group_by': 'project_type'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_consultpro_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">consultpro.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_consultpro_project_search"/>
        <field name="context">{'search_default_active_projects': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first project!
            </p>
        </field>
    </record>

</odoo>