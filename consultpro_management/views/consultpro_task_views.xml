<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="view_consultpro_task_form" model="ir.ui.view">
        <field name="name">consultpro.task.form</field>
        <field name="model">consultpro.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <button name="action_start"
                            string="Start"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'todo'"/>
                    <button name="action_submit_review"
                            string="Submit for Review"
                            type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_mark_done"
                            string="Mark Done"
                            type="object"
                            class="btn-success"
                            invisible="state not in ('in_progress', 'review')"/>
                    <button name="action_reopen"
                            string="Reopen"
                            type="object"
                            invisible="state not in ('done', 'cancelled')"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="todo,in_progress,review,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="Overdue"
                            bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Task Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="parent_task_id"/>
                            <field name="task_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="assigned_to_id"/>
                            <field name="reviewer_id"/>
                            <field name="date_start"/>
                            <field name="date_deadline"/>
                            <field name="date_done" readonly="True"/>
                        </group>
                    </group>
                    <group string="Hours">
                        <group>
                            <field name="estimated_hours"/>
                            <field name="logged_hours" readonly="True"/>
                            <field name="remaining_hours" readonly="True"/>
                        </group>
                        <group>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="desc">
                            <field name="description"/>
                        </page>
                        <page string="Acceptance Criteria" name="criteria">
                            <field name="acceptance_criteria"
                                   placeholder="Define acceptance criteria..."/>
                        </page>
                        <page string="Sub-tasks" name="subtasks">
                            <field name="child_task_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="assigned_to_id"/>
                                    <field name="date_deadline"/>
                                    <field name="estimated_hours"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Timesheets" name="timesheets">
                            <field name="timesheet_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="consultant_id"/>
                                    <field name="name"/>
                                    <field name="hours"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_consultpro_task_list" model="ir.ui.view">
        <field name="name">consultpro.task.list</field>
        <field name="model">consultpro.task</field>
        <field name="arch" type="xml">
            <list string="Tasks"
                  decoration-danger="is_overdue"
                  decoration-muted="state in ('done', 'cancelled')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="assigned_to_id"/>
                <field name="priority" widget="priority"/>
                <field name="date_deadline"/>
                <field name="estimated_hours" optional="show"/>
                <field name="logged_hours" optional="show"/>
                <field name="progress" widget="progressbar" optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state in ('in_progress', 'review')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="is_overdue" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_consultpro_task_kanban" model="ir.ui.view">
        <field name="name">consultpro.task.kanban</field>
        <field name="model">consultpro.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="assigned_to_id"/>
                <field name="date_deadline"/>
                <field name="priority"/>
                <field name="is_overdue"/>
                <field name="project_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-muted small mt-1">
                                <field name="project_id"/>
                            </div>
                            <div class="mt-2 d-flex justify-content-between align-items-center">
                                <field name="assigned_to_id" widget="many2one_avatar"/>
                                <span t-if="record.is_overdue.raw_value"
                                      class="badge text-bg-danger">Overdue</span>
                                <span t-elif="record.date_deadline.value"
                                      class="badge text-bg-light text-dark">
                                    <t t-esc="record.date_deadline.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_consultpro_task_search" model="ir.ui.view">
        <field name="name">consultpro.task.search</field>
        <field name="model">consultpro.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name" string="Task"/>
                <field name="project_id"/>
                <field name="assigned_to_id"/>
                <separator/>
                <filter name="my_tasks"
                        string="My Tasks"
                        domain="[('assigned_to_id.user_id', '=', uid)]"/>
                <filter name="overdue"
                        string="Overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <filter name="open"
                        string="Open"
                        domain="[('state', 'in', ('todo', 'in_progress', 'review'))]"/>
                <filter name="high_priority"
                        string="High Priority"
                        domain="[('priority', 'in', ('1', '2'))]"/>
                <separator/>
                <filter name="group_project"
                        string="Project"
                        context="{'group_by': 'project_id'}"/>
                <filter name="group_assignee"
                        string="Assignee"
                        context="{'group_by': 'assigned_to_id'}"/>
                <filter name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_consultpro_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">consultpro.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_consultpro_task_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks found
            </p>
            <p>Create a task to track work on your project.</p>
        </field>
    </record>

    <record id="action_consultpro_task_my" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">consultpro.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_consultpro_task_search"/>
        <field name="context">{'search_default_my_tasks': 1, 'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                You have no open tasks
            </p>
            <p>Tasks assigned to you will appear here.</p>
        </field>
    </record>

    <!-- WIZARD ACTION -->
    <record id="action_consultpro_project_close_wizard" model="ir.actions.act_window">
        <field name="name">Close Project</field>
        <field name="res_model">consultpro.project.close.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>